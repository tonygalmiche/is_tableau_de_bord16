<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tableau_de_bord" model="ir.module.category">
        <field name="name">Tableaux de bord</field>
        <field name="description">Gestion des tableaux de bord personnalisés</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_tableau_de_bord_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="category_id" ref="module_category_tableau_de_bord"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Les utilisateurs peuvent visualiser les tableaux de bord</field>
    </record>

    <record id="group_tableau_de_bord_manager" model="res.groups">
        <field name="name">Gestionnaire</field>
        <field name="category_id" ref="module_category_tableau_de_bord"/>
        <field name="implied_ids" eval="[(4, ref('group_tableau_de_bord_user'))]"/>
        <field name="comment">Les gestionnaires peuvent créer et modifier leurs propres tableaux de bord</field>
    </record>

    <record id="group_tableau_de_bord_administrateur" model="res.groups">
        <field name="name">Administrateur</field>
        <field name="category_id" ref="module_category_tableau_de_bord"/>
        <field name="implied_ids" eval="[(4, ref('group_tableau_de_bord_manager'))]"/>
        <field name="comment">Les administrateurs peuvent créer et modifier tous les tableaux de bord</field>
    </record>

    <!-- Règle pour les gestionnaires : lecture de tous les TdB, écriture uniquement sur les leurs -->
    <record id="tableau_de_bord_manager_read_all_rule" model="ir.rule">
        <field name="name">Tableau de bord: gestionnaire lecture tous</field>
        <field name="model_id" ref="model_is_tableau_de_bord"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_tableau_de_bord_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="tableau_de_bord_manager_write_own_rule" model="ir.rule">
        <field name="name">Tableau de bord: gestionnaire modification propres TdB</field>
        <field name="model_id" ref="model_is_tableau_de_bord"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_tableau_de_bord_manager'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Règle pour les utilisateurs simples : lecture uniquement des TdB sans restriction
         de consultation, ou dont ils font partie des utilisateurs autorisés en consultation -->
    <record id="tableau_de_bord_user_consultation_rule" model="ir.rule">
        <field name="name">Tableau de bord: utilisateur accès en consultation</field>
        <field name="model_id" ref="model_is_tableau_de_bord"/>
        <field name="domain_force">['|', ('consultation_user_ids', '=', False), ('consultation_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_tableau_de_bord_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Règle pour les administrateurs : tous les droits sur tous les TdB -->
    <record id="tableau_de_bord_admin_full_rule" model="ir.rule">
        <field name="name">Tableau de bord: admin tous droits</field>
        <field name="model_id" ref="model_is_tableau_de_bord"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_tableau_de_bord_administrateur'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Règle de sécurité pour permettre l'accès à tous les filtres utilisateur -->
    <record id="ir_filters_tableau_de_bord_rule" model="ir.rule">
        <field name="name">Tableau de bord: accès à tous les filtres utilisateur</field>
        <field name="model_id" ref="base.model_ir_filters"/>
        <field name="domain_force">[('user_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_tableau_de_bord_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
